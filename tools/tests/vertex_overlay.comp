#version 450
layout(local_size_x = 1) in;
#ifdef READ_REMAP
layout(std430, binding = 0) readonly buffer Remap { uint indices[]; };
layout(std430, binding = 1) writeonly buffer Result { uint result[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    result[i] = indices[i] & 0x3fffffu;
}
#else
layout(std430, binding = 0) buffer VertexData { uint words[]; };
void main() {
    words[gl_GlobalInvocationID.x] ^= 0x13579bdfu;
}
#endif
